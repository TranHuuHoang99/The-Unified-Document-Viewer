# main aggregation server port
PORT=4444

# mocked upstream dealership systems
SALES_API_URL=http://localhost:4445
SERVICE_API_URL=http://localhost:4446
SALES_API_PORT=4445
SERVICE_API_PORT=4446

# aggregation tuning
UPSTREAM_TIMEOUT_MS=3000
CACHE_TTL_MS=60000

# mock data input (json fixtures) / output (sqlite databases)
DATABASE_SALE_INPUT=../gen_database/sales_data.json
DATABASE_SERVICE_INPUT=../gen_database/service_data.json
DATABASE_SALE_OUTPUT=./database/sales.db
DATABASE_SERVICE_OUTPUT=./database/service.db

# mock microservice latency
SALE_LATENCY_MS=2000
SERVICE_LATENCY_MS=0
